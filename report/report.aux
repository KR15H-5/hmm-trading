\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Threshold sweep. Left: accuracy (blue, left axis) falls as the threshold drops, while retrain frequency (orange bars, right axis) rises from $0.68$ to $4.76$ retrains per run. Right: detection lag \emph  {worsens} between $0.50$ and $0.35$, then improves slightly at $0.20$ but never recovers above the no-retrain baseline.}}{9}{figure.caption.14}\protected@file@percent }
\newlabel{fig:thresh-sweep}{{4}{9}{Threshold sweep. Left: accuracy (blue, left axis) falls as the threshold drops, while retrain frequency (orange bars, right axis) rises from $0.68$ to $4.76$ retrains per run. Right: detection lag \emph {worsens} between $0.50$ and $0.35$, then improves slightly at $0.20$ but never recovers above the no-retrain baseline}{figure.caption.14}{}}
